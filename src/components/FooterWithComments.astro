---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
import Comments from './Comments.astro';
import MermaidRuntime from './MermaidRuntime.astro';

const route = Astro.locals.starlightRoute;
const pageId = route?.id ?? '';
const showComments = pageId !== '' && pageId !== 'writing-system';
---

<DefaultFooter>
  <slot />
</DefaultFooter>

<MermaidRuntime />

{
  showComments && <Comments />
}
