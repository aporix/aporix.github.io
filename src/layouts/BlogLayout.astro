---
interface Props {
  title: string;
  description?: string;
}

import MermaidRuntime from '../components/MermaidRuntime.astro';

const { title, description = 'Engineering notes from Aporix.' } = Astro.props;
const pageTitle = title === 'Aporix Notes' ? title : `${title} | Aporix`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="alternate" type="application/rss+xml" title="Aporix RSS" href="/rss.xml" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Aporix</a>
      <nav aria-label="Main navigation">
        <a href="/posts/">Posts</a>
        <a href="/archive/">Archive</a>
        <a href="/tags/">Tags</a>
        <a href="/rss.xml">RSS</a>
        <a href="https://github.com/aporix">GitHub</a>
      </nav>
    </header>
    <main class="page-shell">
      <slot />
    </main>
    <MermaidRuntime />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f8faf8;
    --panel: #ffffff;
    --text: #18211f;
    --muted: #62706d;
    --line: #d8e2df;
    --accent: #0f766e;
    --accent-soft: #d8f7f1;
    --code-bg: #eef5f3;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: 0;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      color-scheme: dark;
      --bg: #0f1413;
      --panel: #151b1a;
      --text: #edf7f4;
      --muted: #a5b8b3;
      --line: #2c3835;
      --accent: #5eead4;
      --accent-soft: #123c39;
      --code-bg: #1d2927;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
  }

  a {
    color: var(--accent);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: 68rem;
    margin: 0 auto;
    padding: 1.25rem 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    color: var(--text);
    font-weight: 750;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.4rem 1rem;
    font-size: 0.95rem;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--text);
  }

  .page-shell {
    max-width: 48rem;
    margin: 0 auto;
    padding: 3rem 1.25rem 5rem;
  }

  .wide-shell {
    max-width: 68rem;
  }

  .page-kicker,
  .post-meta,
  .archive-date {
    color: var(--muted);
    font-size: 0.95rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    line-height: 1.05;
  }

  h2 {
    margin-top: 2.5rem;
  }

  .lede {
    max-width: 42rem;
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 1.1rem;
    line-height: 1.7;
  }

  .post-list {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .post-item {
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }

  .post-item h2,
  .post-item h3 {
    margin: 0.25rem 0 0.5rem;
    font-size: 1.35rem;
    line-height: 1.25;
  }

  .post-item h2 a,
  .post-item h3 a {
    color: var(--text);
    text-decoration: none;
  }

  .post-item h2 a:hover,
  .post-item h3 a:hover {
    color: var(--accent);
  }

  .post-item p {
    margin: 0.5rem 0 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: 0.16rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--panel);
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.2;
    text-decoration: none;
  }

  .tag:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .prose {
    margin-top: 2rem;
    font-size: 1.03rem;
    line-height: 1.82;
  }

  .prose h2,
  .prose h3 {
    line-height: 1.25;
  }

  .prose img {
    max-width: 100%;
    height: auto;
  }

  .prose pre {
    overflow-x: auto;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    background: var(--code-bg);
  }

  .prose code {
    border-radius: 0.25rem;
    background: var(--code-bg);
    padding: 0.12rem 0.24rem;
  }

  .prose pre code {
    background: transparent;
    padding: 0;
  }

  .mermaid-diagram {
    overflow-x: auto;
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: 0.45rem;
    background: var(--panel);
  }

  .mermaid-diagram svg {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }

  .mermaid-error {
    border-color: #b42318;
  }

  .archive-year {
    margin-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .archive-row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }

  .archive-row a {
    color: var(--text);
    font-weight: 650;
    text-decoration: none;
  }

  .archive-row a:hover {
    color: var(--accent);
  }

  .empty-note {
    margin-top: 2rem;
    color: var(--muted);
  }

  .comments-block {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .comments-block h2 {
    margin-top: 0;
    font-size: 1.35rem;
  }

  .comments-block p {
    color: var(--muted);
  }

  @media (max-width: 42rem) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
    }

    nav {
      justify-content: flex-start;
    }

    .archive-row {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
