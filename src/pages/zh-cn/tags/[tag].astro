---
import { getCollection } from 'astro:content';
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { getLocaleConfig } from '../../../config/i18n';
import { filterPostsByLocale, formatDate, getPostHref, getTagIndex, getTagSlug, sortPosts } from '../../../lib/posts';

export async function getStaticPaths() {
  const locale = 'zh-cn';
  const posts = sortPosts(filterPostsByLocale(await getCollection('posts', ({ data }) => !data.draft), locale));
  const tagIndex = getTagIndex(posts);

  return [...tagIndex.entries()].map(([tag, taggedPosts]) => ({
    params: { tag: getTagSlug(tag) },
    props: { tag, posts: taggedPosts, locale },
  }));
}

const { tag, posts, locale } = Astro.props;
const config = getLocaleConfig(locale);
---

<BlogLayout title={`标签：${tag}`} description={`标签为 ${tag} 的文章。`} locale={locale}>
  <section>
    <p class="page-kicker">{config.tagsTitle}</p>
    <h1>{tag}</h1>
    <p class="lede">{config.postCount(posts.length)}</p>
  </section>

  <section class="post-list" aria-label="Posts">
    {posts.map((post) => (
      <article class="post-item">
        <p class="post-meta">{formatDate(post.data.date, locale)}</p>
        <h2><a href={getPostHref(post)}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
      </article>
    ))}
  </section>
</BlogLayout>
