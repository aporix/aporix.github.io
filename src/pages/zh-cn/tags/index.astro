---
import { getCollection } from 'astro:content';
import BlogLayout from '../../../layouts/BlogLayout.astro';
import { getLocaleConfig } from '../../../config/i18n';
import { filterPostsByLocale, getTagHref, getTagIndex, sortPosts } from '../../../lib/posts';

const locale = 'zh-cn';
const config = getLocaleConfig(locale);
const posts = sortPosts(filterPostsByLocale(await getCollection('posts', ({ data }) => !data.draft), locale));
const tagIndex = getTagIndex(posts);
const tags = [...tagIndex.entries()].sort((a, b) => a[0].localeCompare(b[0], config.lang));
---

<BlogLayout title={config.tagsTitle} description={config.tagsDescription} locale={locale}>
  <section>
    <p class="page-kicker">{config.tagsTitle}</p>
    <h1>{config.tagsHeading}</h1>
    <p class="lede">{config.tagsDescription}</p>
  </section>

  <section class="tag-list" aria-label="Tags">
    {tags.map(([tag, taggedPosts]) => (
      <a class="tag" href={getTagHref(tag, locale)}>{tag} · {taggedPosts.length}</a>
    ))}
  </section>
</BlogLayout>
