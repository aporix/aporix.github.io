---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { getLocaleConfig } from '../../config/i18n';
import { filterPostsByLocale, formatDate, getPostHref, groupPostsByYear, sortPosts } from '../../lib/posts';

const locale = 'zh-cn';
const config = getLocaleConfig(locale);
const posts = sortPosts(filterPostsByLocale(await getCollection('posts', ({ data }) => !data.draft), locale));
const groups = groupPostsByYear(posts);
const years = Object.keys(groups).sort((a, b) => Number(b) - Number(a));
---

<BlogLayout title={config.archiveTitle} description={config.archiveDescription} locale={locale}>
  <section>
    <p class="page-kicker">{config.archiveTitle}</p>
    <h1>{config.archiveHeading}</h1>
    <p class="lede">{config.archiveDescription}</p>
  </section>

  {years.map((year) => (
    <section class="archive-year">
      <h2>{year}</h2>
      {groups[year].map((post) => (
        <div class="archive-row">
          <span class="archive-date">{formatDate(post.data.date, locale)}</span>
          <a href={getPostHref(post)}>{post.data.title}</a>
        </div>
      ))}
    </section>
  ))}
</BlogLayout>
