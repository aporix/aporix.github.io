---
import { getCollection } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import { formatDate, getPostHref, groupPostsByYear, sortPosts } from '../lib/posts';

const posts = sortPosts(await getCollection('posts', ({ data }) => !data.draft));
const groups = groupPostsByYear(posts);
const years = Object.keys(groups).sort((a, b) => Number(b) - Number(a));
---

<BlogLayout title="Archive" description="All Aporix posts grouped by year.">
  <section>
    <p class="page-kicker">Archive</p>
    <h1>All posts</h1>
    <p class="lede">A chronological index for older notes and essays.</p>
  </section>

  {years.map((year) => (
    <section class="archive-year">
      <h2>{year}</h2>
      {groups[year].map((post) => (
        <div class="archive-row">
          <span class="archive-date">{formatDate(post.data.date)}</span>
          <a href={getPostHref(post)}>{post.data.title}</a>
        </div>
      ))}
    </section>
  ))}
</BlogLayout>
